# GPU training image: environment only, no code. CUDA base + uv + pre-warmed
# package cache; the repo is cloned on the pod (see docs/remote-gpu.md).
# Shell access goes through the provider's SSH proxy or web terminal;
# checkpoints leave via HF Hub.
FROM nvidia/cuda:13.0.2-devel-ubuntu24.04

# Build-time only (ARG, not ENV): stop apt from prompting during the build.
ARG DEBIAN_FRONTEND=noninteractive
ARG NVIM_VERSION=0.11.3

# PYTHONUNBUFFERED: flush prints immediately so training logs stream live.
# UV_PYTHON: uv provisions its own CPython, no system python needed.
# UV_LINK_MODE=copy: uv's default hardlinks break across docker layers.
ENV PYTHONUNBUFFERED=1
ENV UV_PYTHON=3.12
ENV UV_LINK_MODE=copy
ENV PATH="/root/.local/bin:${PATH}"

# One layer: install + cache cleanup must be chained, deleting the apt lists
# in a later layer would not shrink the image.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    openssh-server \
    vim \
  && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /run/sshd /root/.ssh \
  && chmod 700 /root/.ssh \
  && sed -i '/^#\?PermitRootLogin /d; /^#\?PasswordAuthentication /d; /^#\?PubkeyAuthentication /d' /etc/ssh/sshd_config \
  && printf '%s\n' 'PermitRootLogin prohibit-password' 'PasswordAuthentication no' 'PubkeyAuthentication yes' >> /etc/ssh/sshd_config \
  && sed -i 's@session\s*required\s*pam_loginuid.so@session optional pam_loginuid.so@g' /etc/pam.d/sshd \
  && ssh-keygen -A

RUN curl -fL "https://github.com/neovim/neovim/releases/download/v${NVIM_VERSION}/nvim-linux-x86_64.tar.gz" -o /tmp/nvim.tar.gz \
  && mkdir -p /opt/nvim \
  && tar -xzf /tmp/nvim.tar.gz --strip-components=1 -C /opt/nvim \
  && ln -s /opt/nvim/bin/nvim /usr/local/bin/nvim \
  && rm /tmp/nvim.tar.gz

RUN curl -LsSf https://astral.sh/uv/install.sh | sh

# Prime's SSH/web shell can start as a login shell with a reset PATH, so keep
# uv available there as well as through Docker's ENV above.
RUN printf '%s\n' 'export PATH="/root/.local/bin:$PATH"' \
    >> /root/.bashrc \
  && printf '%s\n' 'export PATH="/root/.local/bin:$PATH"' \
    >> /root/.profile

RUN git clone --depth 1 https://github.com/Graffioh/dotfiles.git /tmp/dotfiles \
  && test -d /tmp/dotfiles/nvim \
  && mkdir -p /root/.config \
  && cp -a /tmp/dotfiles/nvim /root/.config/nvim \
  && rm -rf /tmp/dotfiles

# Warm uv's global cache with everything uv.lock pins, so the first
# `uv sync` inside the git clone copies from cache in seconds instead of
# re-downloading multi-GB wheels. The warmup venv itself is discarded in the
# same layer; the clone creates its own.
COPY pyproject.toml uv.lock /opt/deps-warmup/
RUN cd /opt/deps-warmup \
  && uv sync --frozen --no-install-project \
  && rm -rf /opt/deps-warmup/.venv

# Land new shells on the persistent volume, where the clone lives.
WORKDIR /workspace
