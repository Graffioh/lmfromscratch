# GPU training image: environment only, no code. CUDA base + uv + pre-warmed
# package cache; the repo is cloned on the pod (see docs/remote-gpu.md).
# Shell access goes through the provider's SSH proxy or web terminal;
# checkpoints leave via HF Hub.
FROM nvidia/cuda:13.0.2-devel-ubuntu24.04

# Build-time only (ARG, not ENV): stop apt from prompting during the build.
ARG DEBIAN_FRONTEND=noninteractive

# PYTHONUNBUFFERED: flush prints immediately so training logs stream live.
# UV_PYTHON: uv provisions its own CPython, no system python needed.
# UV_LINK_MODE=copy: uv's default hardlinks break across docker layers.
ENV PYTHONUNBUFFERED=1
ENV UV_PYTHON=3.12
ENV UV_LINK_MODE=copy
ENV PATH="/root/.local/bin:${PATH}"

# One layer: install + cache cleanup must be chained, deleting the apt lists
# in a later layer would not shrink the image.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    vim \
  && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | sh

# Warm uv's global cache with everything uv.lock pins, so the first
# `uv sync` inside the git clone copies from cache in seconds instead of
# re-downloading multi-GB wheels. The warmup venv itself is discarded in the
# same layer; the clone creates its own.
COPY pyproject.toml uv.lock /opt/deps-warmup/
RUN cd /opt/deps-warmup \
  && uv sync --frozen --no-install-project \
  && rm -rf /opt/deps-warmup/.venv

# Land new shells on the persistent volume, where the clone lives.
WORKDIR /workspace

# A container only lives as long as its CMD; sleep keeps the pod up so the
# provider's terminal can attach.
CMD ["sleep", "infinity"]
